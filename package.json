{
	"name": "@engfinecode/dv-agent",
	"version": "0.0.1",
	"author": "Happy Penguin (engfinecode) <engfinecode@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/engfinecode/dv-agent.git"
	},
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"dv": "./bin/dv.js",
		"dv-agent": "./bin/dv.js"
	},
	"files": [
		"dist/",
		"bin/",
		"contracts/run-accounting-contract-v4.json",
		"contracts/run-accounting-contract-v5.json",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"description": "DV agent: deterministic verification harness with routing, ledger accounting, and offline evaluation.",
	"workspaces": [
		"packages/runtime-pi/pi-schema",
		"packages/runtime-pi/pi-telemetry",
		"packages/runtime-pi/pi-ai",
		"packages/runtime-pi/pi-agent-core",
		"packages/dv-core",
		"packages/dv-eval"
	],
	"scripts": {
		"build:dist": "node scripts/build-dist.mjs",
		"prepack": "npm run build:dist",
		"build:runtime": "node scripts/build-runtime.mjs",
		"hydrate:pi-ai-data": "npm run hydrate-model-data -w @earendil-works/pi-ai",
		"probe:providers": "node packages/dv-eval/src/probe/cli.ts",
		"smoke": "node scripts/dv-smoke.ts",
		"bench": "node scripts/dv-bench.ts",
		"metrics": "node scripts/dv-bench-metrics.ts",
		"typecheck": "tsc -p packages/dv-core/tsconfig.json && tsc -p packages/dv-eval/tsconfig.json && tsc -p tsconfig.dist.json --noEmit",
		"test": "node --test packages/dv-core/test/*.test.ts packages/dv-eval/test/*.test.ts",
		"lint": "biome check packages/dv-core packages/dv-eval scripts src",
		"lint:fix": "biome check --write packages/dv-core packages/dv-eval scripts src"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.129.0",
		"@aws-sdk/client-bedrock-runtime": "3.1127.0",
		"@aws-sdk/credential-provider-node": "3.972.82",
		"@google/genai": "2.32.0",
		"@smithy/node-http-handler": "4.12.1",
		"http-proxy-agent": "9.1.0",
		"https-proxy-agent": "9.1.0",
		"openai": "7.59.0",
		"partial-json": "0.1.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
